{
  "name": "glyphra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "verify": "npm run verify:ciphers && npm run verify:assessment && npm run verify:quiz && npm run verify:filters && npm run verify:problems && npm run verify:language && npm run verify:analysis && npm run verify:session",
    "check-solana": "tsx --env-file=.env.local scripts/check-solana.ts",
    "// build": "Verification runs first, so a technique that stopped round-tripping stops the deploy rather than reaching a student.",
    "build": "npm run verify && next build",
    "start": "next start",
    "lint": "eslint",
    "video": "remotion render video/src/index.ts Promo out/glyphra-promo.mp4",
    "video:square": "remotion render video/src/index.ts PromoSquare out/glyphra-promo-square.mp4",
    "video:studio": "remotion studio video/src/index.ts",
    "verify:ciphers": "tsx scripts/verify-ciphers.ts",
    "verify:assessment": "tsx scripts/verify-assessment.ts",
    "video:vertical": "remotion render video/src/index.ts PromoVertical out/glyphra-promo-vertical.mp4",
    "verify:quiz": "tsx scripts/verify-quiz.ts",
    "verify:filters": "tsx scripts/verify-filters.ts",
    "migrate": "tsx --conditions=react-server --env-file=.env.local scripts/migrate.ts",
    "verify:db": "tsx --conditions=react-server --env-file=.env.local scripts/verify-db.ts",
    "verify:doors": "tsx --conditions=react-server --env-file=.env.local scripts/verify-doors.ts",
    "verify:problems": "tsx --conditions=react-server scripts/verify-problems.ts",
    "verify:flow": "tsx --conditions=react-server scripts/verify-problem-flow.ts",
    "verify:compose": "tsx --conditions=react-server --env-file=.env.local scripts/verify-compose.ts",
    "verify:browser": "python scripts/verify-browser.py",
    "verify:language": "tsx --conditions=react-server scripts/verify-language.ts",
    "verify:session": "tsx --conditions=react-server scripts/verify-session.ts",
    "verify:login": "python scripts/verify-login.py",
    "verify:viewer": "python scripts/verify-viewer.py",
    "verify:court": "python scripts/verify-court.py",
    "verify:tongue": "python scripts/verify-tongue.py",
    "verify:analysis": "tsx scripts/verify-analysis.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@solana/web3.js": "^1.98.4",
    "@types/qrcode": "^1.5.6",
    "bs58": "^6.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "jose": "^6.2.8",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.512",
    "@remotion/player": "^4.0.512",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "remotion": "^4.0.512",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5"
  }
}
